# =============================================================================
# SOPHY — modelo de configuração
# Copie para .env (cp .env.example .env) e preencha. NUNCA envie o .env ao Git.
# Valores vazios = função desligada. Nada aqui é obrigatório, exceto os caminhos.
# =============================================================================

# ---- Seu nome (a persona usa este nome) -------------------------------------
CREATOR_NAME=seu_nome

# ---- Motor local (Ollama) ----------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REASONING_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_TEMP_TOOLS=0.1
OLLAMA_TEMP_CREATIVE=0.78
OLLAMA_KEEP_ALIVE=5m

# ---- Caminhos ----------------------------------------------------------------
# Recomendado: um cofre Obsidian FORA do repositório (ex.: ~/Documents/Sophy-Vault).
OBSIDIAN_VAULT_PATH=./obsidian_vault
# Pastas de código que a Sophy pode LER e EDITAR (separadas por vírgula).
ALLOWED_CODE_DIRS=.
# Pastas só de leitura (PDFs, apostilas). Padrão: Documents e Downloads.
READ_ONLY_DIRS=~/Documents,~/Downloads
SQLITE_DB_PATH=./database/hybrid_ai.db
CHROMA_DB_PATH=./database/chroma_db

# ---- Limites e modo ----------------------------------------------------------
MAX_TOOL_ITERATIONS=3
# true = nenhuma chamada à internet (nuvem e Google). Também pode ser ligado só por sessão: sophy --offline
STRICT_OFFLINE_MODE=false
TIMEZONE=America/Sao_Paulo

# ---- Painel web --------------------------------------------------------------
GUI_HOST=127.0.0.1
GUI_PORT=8080

# ---- Nuvem (opcional): usada quando há internet e a chave está preenchida ----
PREFER_CLOUD_WHEN_ONLINE=true
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_MODEL=gemini-3.1-flash-lite
OPENAI_CODE_API_KEY=
OPENAI_CODE_BASE_URL=https://opencode.ai/zen/v1
OPENAI_CODE_MODEL=gpt-4o-mini

# ---- Discord (opcional) ------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# ---- Google Calendar / Gmail / Drive (opcional, via gws-cli) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ACCESS_TOKEN=

# ---- WhatsApp (opcional) -----------------------------------------------------
WHATSAPP_BRIDGE_PORT=3001
WHATSAPP_PAIRED=false

# ---- Spotify (opcional) ------------------------------------------------------
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# ---- Outras APIs (opcionais) -------------------------------------------------
ANTHROPIC_API_KEY=
COMPOSIO_API_KEY=
FINANCE_FINTEL_API_KEY=
FINANCE_ADANOS_API_KEY=
ALPHA_VANTAGE_API_KEY=
